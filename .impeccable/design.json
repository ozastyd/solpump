  "narrative": {
    "northStar": "The Field Console",
    "overview": "SolPump Operations looks like instrumentation built for people who watch water move: a dark pine sidebar housing the controls, a bright instrument face where the data lives, and status communicated in tinted chips that can be read in one sweep. Every panel earns its place by carrying a number, a state, or a control — decoration that does not help someone scan loses. The aesthetic philosophy is operational credibility: this should feel like software a utility would actually run, not a marketing mock of one.\n\nLight theme is the default (misty paper background, white instrument cards); dark theme is a first-class twin driven by prefers-color-scheme and [data-theme], never an afterthought. Confirmed visual rejections: shadows as hierarchy, gradients, glow, and any hue outside the token set.",
    "keyCharacteristics": [
      "Hairline borders and tinted surfaces carry hierarchy; surfaces are flat at rest",
      "All figures set in Barlow Semi Condensed with tabular numerals for column alignment",
      "Status always arrives as a tinted pill pair (tint background + saturated text), never bare color",
      "Signal Yellow (#F7DC00) marks the live/demo state and nothing else",
      "Dense but breathing: 4–14px padding steps, generous whitespace only around narrative copy"
    ],
    "rules": [
      { "name": "The Signal Yellow Rule", "body": "#F7DC00 marks liveness (active nav indicator, DEMO badge, demo clock pill). Its rarity is the point — never use it for body text, large fills, or generic highlights.", "section": "colors" },
      { "name": "The Status Pair Rule", "body": "Status color never appears as bare text or bare fill: it is always the semantic tint background with the saturated semantic text on top, inside a pill.", "section": "colors" },
      { "name": "The Tabular Figure Rule", "body": "Anything that is a number in a column uses the numeric family with tabular figures — alignment is part of credibility.", "section": "typography" },
      { "name": "The Overlay-Only Shadow Rule", "body": "Shadows exist only on things that physically float above the page (popup, modal, toast, drawer). Content cards stay flat; if you need separation, reach for a border or the surface step first.", "section": "elevation" }
    ],
    "dos": [
      "Do set every metric in the numeric family with tabular figures (var(--num) + tabular-nums)",
      "Do express status as tinted pill pairs (tint bg + saturated text) — four canonical pairs only",
      "Do separate surfaces with hairlines (--line/--line2) and the paper↔card step before considering a shadow",
      "Do keep AA text contrast in both themes (muted text ≥ 4.5:1 on its surface)",
      "Do mark absent data as \"no sensor\", never as 0",
      "Do reserve Signal Yellow for live/demo indicators"
    ],
    "donts": [
      "Don't add shadows to content cards — overlays only",
      "Don't introduce hues outside the token set, gradients, or glow effects",
      "Don't use Signal Yellow as text or a large fill",
      "Don't let numbers default to the body font in tables or KPI strips",
      "Don't animate under prefers-reduced-motion (all transitions are already disabled there)"
    ]
  }
}
